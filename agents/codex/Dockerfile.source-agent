# Build the Codex binary from this repository's upstream source on top of one
# official SWE-bench task image. The resulting image is selected by runtime.toml.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY upstream/codex-rs /opt/tokenana/codex-rs
WORKDIR /opt/tokenana/codex-rs

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . /root/.cargo/env \
    && cargo build --release --locked --bin codex \
    && install -Dm755 target/release/codex /opt/tokenana/codex \
    && rm -rf target

RUN mkdir -p /root/.codex
WORKDIR /testbed
ENV TOKENANA_CODEX=/opt/tokenana/codex
